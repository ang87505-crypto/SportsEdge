{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/paper-auto/kickoff",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/internal/scheduler/props-settle-morning",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/internal/scheduler/props-settle-midday",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/internal/scheduler/props-collect-early",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/internal/scheduler/props-collect-late",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/internal/scheduler/research-collect",
      "schedule": "0 4 * * 2-6"
    },
    {
      "path": "/api/internal/scheduler/ops-monitor",
      "schedule": "0 13 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  }
}
